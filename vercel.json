{
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "shareit-six.vercel.app" }],
      "destination": "https://shareit.co.ke/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "shareitt.xyz" }],
      "destination": "https://shareit.co.ke/$1",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "www.shareitt.xyz" }],
      "destination": "https://shareit.co.ke/$1",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
